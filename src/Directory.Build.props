<Project>
  <!-- Comum aos projetos. .NET 10 LTS (suporte até 11/2028). Windows e Linux: o que muda por sistema mora em So.cs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>3.0.3</Version>
    <Product>Pitstop</Product>
    <Description>Runner local para Tomcat, Java, npm, pacotes e comandos personalizados.</Description>
    <RepositoryUrl>https://github.com/Thameus/Pitstop</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Thameus/Pitstop</PackageProjectUrl>
    <Authors>Matheus Silva</Authors>
    <Copyright>Copyright 2026 Matheus Silva</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
