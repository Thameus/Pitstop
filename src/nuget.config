<?xml version="1.0" encoding="utf-8"?>
<!-- Fonte dos pacotes do Avalonia (a janela). Local ao projeto: não depende da config global do NuGet da máquina. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
