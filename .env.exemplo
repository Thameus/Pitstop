# Pitstop - ajustes globais
# Modelo do .env. Na primeira execução o assistente cria o .env a partir daqui; depois, edite pela tela de Ajustes
# (engrenagem na lateral, menu da bandeja ou o diálogo Ajustes da tela web) ou à mão.
# Formato CHAVE=valor. Linhas com # são comentário. Aspas são opcionais. Chave ausente ou vazia = padrão.
# O que estiver aqui manda sobre o bloco global do config/perfis.json; cada perfil ainda pode informar o seu.

# ---- Tela --------------------------------------------------------------------
# Porta da tela web e da API: http://localhost:<RUNNER_PORTA>/ (padrão 9999)
# RUNNER_PORTA=9999
# pit ui: abrir o navegador sozinho quando sobe (true/false)
RUNNER_ABRIR_NAVEGADOR=true

# ---- Caminhos padrão (vazio = cada perfil informa o seu) ----------------------
# Pasta dos repositórios Maven (bloco "Projetos" dos perfis Tomcat)
# PROJETOS_DIR=
# Tomcat (CATALINA_HOME) dos perfis que não informam outro
# TOMCAT_HOME=
# JDK (JAVA_HOME) do Tomcat, do Maven e dos apps; vazio = JAVA_HOME do sistema
# JDK_HOME=
# Maven (pasta com bin/mvn); vazio = mvn do PATH
# MAVEN_HOME=
# Onde ficam os CATALINA_BASE de cada perfil (<pasta>/<perfil>); vazio = <Pitstop>/bases
# BASES_DIR=
# Pasta de releases: uma subpasta por versão com o .war/.zip/.jar dentro (perfis "war" e "zip")
# PACOTES_DIR=
# Arquivo de perfis (relativo à pasta do Pitstop ou absoluto)
PERFIS_ARQUIVO=config/perfis.json

# ---- Maven -------------------------------------------------------------------
# Argumentos sugeridos para artefato novo (vira "mvn <args> -pl <modulo> -am"). Artefato já salvo mantém o dele.
# MAVEN_ARGS=-B -ntp package -DskipTests
# Maven offline (-o) no classpath e na compilação do app Java: só com as dependências já baixadas no .m2
# MAVEN_OFFLINE=false

# ---- Comportamento -----------------------------------------------------------
# Segundos esperando o stop gracioso antes de matar o processo
# STOP_TIMEOUT_SEG=20
# Linhas de log guardadas por perfil na memória
LOG_MAX_LINHAS=5000
# Linhas que a tela web recebe ao abrir/F5 (a tela mostra no máximo 2000)
LOG_REPLAY_LINHAS=1500
